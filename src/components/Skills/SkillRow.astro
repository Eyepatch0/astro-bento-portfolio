---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  skills: string[];
  id: string;
}

const { name, skills, id } = Astro.props;

const skillIcons: { [key: string]: string } = {
  Python: "simple-icons:python",
  React: "simple-icons:react",
  TypeScript: "simple-icons:typescript",
  JavaScript: "simple-icons:javascript",
  "Node.js": "simple-icons:nodedotjs",
  MongoDB: "simple-icons:mongodb",
  PostgreSQL: "simple-icons:postgresql",
  MySQL: "simple-icons:mysql",
  TensorFlow: "simple-icons:tensorflow",
  "Scikit-learn": "simple-icons:scikitlearn",
  "Deep Learning": "ri:brain-2-line",
  PyTorch: "simple-icons:pytorch",
  Expo: "simple-icons:expo",
  Pandas: "simple-icons:pandas",
  NumPy: "simple-icons:numpy",
  HTML: "simple-icons:html5",
  "React Native": "simple-icons:react",
  Mongoose: "simple-icons:mongoose",
  SQL: "ri:database-2-line",
  Astro: "simple-icons:astro",
  Tailwind: "simple-icons:tailwindcss",
  BootStrap: "simple-icons:bootstrap",
  "React Bootstrap": "simple-icons:reactbootstrap",
  Plotly: "simple-icons:plotly",
  Selenium: "simple-icons:selenium",
  CSS: "simple-icons:css",
  SQLAlchemy: "simple-icons:sqlalchemy",
  Sequelize: "simple-icons:sequelize",
  AWS: "simple-icons:amazonwebservices",
  GCP: "simple-icons:googlecloud",
  Vercel: "simple-icons:vercel",
  Cloudflare: "simple-icons:cloudflare",
  "Cloudflare Pages": "simple-icons:cloudflarepages",
  "Cloudflare Workers": "simple-icons:cloudflareworkers",
  SQLite: "simple-icons:sqlite"
};
---

<section id={id} class="scroll-m-20">
  <h2 class="text-2xl font-bold mb-6 text-neutral-100 text-center">
    {name}
  </h2>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    {
      skills.map((skill) => (
        <div class="bg-neutral-800 p-4 rounded-lg border border-darkslate-100 hover:border-primary-500 transition-colors flex flex-col items-center gap-2">
          {skillIcons[skill] && (
            <Icon name={skillIcons[skill]} class="h-6 w-6 text-primary-500" />
          )}
          <span class="text-sm font-medium text-center text-neutral-100">
            {skill}
          </span>
        </div>
      ))
    }
  </div>
</section>

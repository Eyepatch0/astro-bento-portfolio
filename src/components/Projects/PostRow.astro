---
interface Props {
  title: string;
  tag: string[];
  url: string;
}

const { title, tag, url } = Astro.props;
---

<li
  class="list-none w-full text-neutral-100 hover:text-neutral-400 ease-in-out transition-colors border-b-neutral-400 border-dashed border-b-1 my-2"
>
  <a
    class="text-sm md:text-base decoration-none flex flex-col md:flex-row md:justify-between gap-2"
    href={`/projects/${url}`}
  >
    <p class="inline-block">
      {title}
    </p>
    <div class="flex flex-wrap gap-2">
      {
        tag.map((item) => (
          <span class="bg-neutral-800 px-2 py-0.5 rounded text-xs">{item}</span>
        ))
      }
    </div>
  </a>
</li>

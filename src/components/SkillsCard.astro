---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  colorText="text-neutral-100"
>
  <a href="/skills" class="h-full w-full">
    <Icon
      name="ri:settings-4-line"
      class="h-6 float-right group-hover:text-primary-500 group-hover:rotate-90 transition-transform ease-in-out duration-200 z-20"
    />
    <h2 class="text-xl font-bold">Skills</h2>
  </a>
</Card>

---
import BasicLayout from "./BasicLayout.astro";

type Props = {
  title: string;
  description: string;
  url: string;
  repository: string;
  tag: string[];
  pubDate: Date;
};

const { title, description, url, repository, tag } = Astro.props;
---

<BasicLayout slug={url} page="projects" title={title} description={description}>
  <main class="mx-auto max-w-3xl w-full h-screen p-8 text-neutral-100">
    <a
      href="/projects"
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 border-1 border-solid border-neutral-600 rounded-lg mb-8"
      >Back</a
    >
    <div class="my-10">
      <h1 class="text-5xl font-semibold">{title}</h1>
      <div class="flex justify-between pt-4 text-gray-500 text-sm">
        <a
          href={repository}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-gray-400"
        >
          View Repository
        </a>
        <div class="flex gap-2">
          {
            tag.map((item) => (
              <span class="bg-neutral-800 px-2 py-1 rounded">{item}</span>
            ))
          }
        </div>
      </div>
    </div>
    <article class="prose prose-slate prose-invert">
      <slot />
    </article>
  </main>
</BasicLayout>

---
import Layout from "../../layouts/Layout.astro";
import { skillCategories } from "../../data/skills";
import SkillRow from "../../components/Skills/SkillRow.astro";
---

<script>
  import { timeline, type TimelineDefinition } from "motion";
  import { loaderAnimation } from "../../lib/constants";
  const sequence = [loaderAnimation];
  timeline(sequence as TimelineDefinition);
</script>

<Layout
  title="Mohammed Syed - Skills"
  description="My technical skills and expertise"
>
  <main
    class="w-screen h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8"
  >
    <a
      href="/"
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg"
    >
      Back
    </a>
    <h1 class="text-4xl font-bold mb-4 text-neutral-100 w-full text-center">
      Skills
    </h1>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-8 w-full">
      {
        skillCategories.map((category) => (
          <a
            href={`#${category.id}`}
            class="bg-neutral-200 hover:bg-primary-500 hover:text-neutral-200 px-4 py-3 rounded-lg text-sm font-extrabold transition-colors text-neutral-900 border border-darkslate-100 hover:border-primary-500 flex items-center justify-center text-center"
          >
            {category.name}
          </a>
        ))
      }
    </div>
    <div class="w-full space-y-12 pb-10">
      {
        skillCategories.map((category) => (
          <SkillRow
            name={category.name}
            skills={category.skills}
            id={category.id}
          />
        ))
      }
    </div>
  </main>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
